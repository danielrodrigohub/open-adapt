<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="99dp">
    <View
        android:id="@+id/fragment_connecting_blur_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/adapt_connecting_title"
        android:elevation="99dp"/>
    <ImageView
        android:id="@+id/fragment_connecting_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/adapt_connecting_title"
        android:elevation="99dp"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/fragment_connecting_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/adapt_home_view_connect_devices_message"
        android:minLines="2"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:elevation="99dp"
        style="@style/BigfootH1"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/fragment_connecting_progress_bar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="-20dp"
        android:elevation="99dp"
        android:indeterminateTint="@color/white"/>
</FrameLayout>
