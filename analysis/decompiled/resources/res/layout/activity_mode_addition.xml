<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mode_addition_container"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/activity_mode_addition_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textColor="#fff"
        android:id="@+id/messaging_headline_title"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/adapt_modes_add_mode_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BigfootH1"/>
    <TextView
        android:textColor="#fff"
        android:id="@+id/messaging_headline_message_1"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/adapt_modes_add_mode_copy"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_headline_title"
        style="@style/BigfootBody"/>
    <TextView
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/activity_mode_addition_cancel"
        android:background="@drawable/text_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="80dp"
        android:minHeight="42dp"
        android:text="@string/adapt_modes_cancel_button_title"
        android:textAlignment="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/activity_mode_addition_save"
        app:layout_constraintTop_toBottomOf="@+id/activity_mode_rename_add_container"
        style="@style/BigfootButtonLabel"/>
    <TextView
        android:enabled="false"
        android:textColor="@color/white_button_with_disable"
        android:gravity="center"
        android:id="@+id/activity_mode_addition_save"
        android:background="@drawable/text_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="80dp"
        android:minHeight="42dp"
        android:text="@string/adapt_modes_save_button_title"
        android:textAlignment="center"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_mode_rename_add_container"
        style="@style/BigfootButtonLabel"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_mode_rename_add_container"
        android:background="@drawable/create_mode_button_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messaging_headline_message_1"
        app:layout_constraintVertical_bias="0.3">
        <EditText
            android:theme="@style/TextInputStyle"
            android:textColor="@android:color/white"
            android:textColorHint="#99ffffff"
            android:gravity="start|center_vertical"
            android:id="@+id/activity_mode_addition_edit_text"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:minHeight="64dp"
            android:hint="@string/adapt_modes_text_field_suggested_name"
            android:maxLength="24"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_set_selection_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/activity_mode_rename_add_container"
            app:layout_constraintEnd_toStartOf="@+id/activity_mode_addition_edit_text"
            app:layout_constraintStart_toStartOf="@+id/activity_mode_rename_add_container"
            app:layout_constraintTop_toTopOf="@+id/activity_mode_rename_add_container"/>
        <View
            android:id="@+id/view_set_selection_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/activity_mode_rename_add_container"
            app:layout_constraintEnd_toEndOf="@+id/activity_mode_rename_add_container"
            app:layout_constraintStart_toEndOf="@+id/activity_mode_addition_edit_text"
            app:layout_constraintTop_toTopOf="@+id/activity_mode_rename_add_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
