<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/activity_edit_mode"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textColor="#fff"
            android:id="@+id/messaging_headline_title_edit"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/adapt_modes_edit_title"
            android:layout_weight="3"
            style="@style/BigfootH1"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="18dp"/>
        <TextView
            android:textColor="#fff"
            android:id="@+id/messaging_headline_message_1_edit"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adapt_modes_edit_copy"
            android:fontFamily="@font/helvetica_neue_regular"
            style="@style/BigfootBody"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/activity_mode_edit_recycle_view"
        android:paddingTop="200dp"
        android:paddingBottom="200dp"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/activity_edit_mode_done_container"
        android:background="@drawable/create_mode_button_background"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:animateLayoutChanges="true">
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/activity_edit_mode_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adapt_done_cta_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </FrameLayout>
</FrameLayout>
