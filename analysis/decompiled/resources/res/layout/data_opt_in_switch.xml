<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/view_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_toolbar"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center"
        android:id="@+id/data_opt_in_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_toolbar"
        app:theme="@style/SwitchCompatBlueStyle"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/data_opt_in_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/data_opt_in_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/data_opt_in_switch"
        app:layout_constraintTop_toBottomOf="@+id/view_toolbar"
        style="?android:attr/progressBarStyleSmall"/>
    <TextView
        android:textSize="20sp"
        android:id="@+id/data_opt_in_switch_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/adapt_footwear_diagnostics_title"
        android:layout_marginStart="24dp"
        android:labelFor="@+id/data_opt_in_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_toolbar"
        style="@style/BigfootH3"/>
    <TextView
        android:textColor="@color/darkish_gray"
        android:id="@+id/data_opt_in_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/adapt_data_opt_in_sub_header"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_opt_in_setting_divider"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="16dp"/>
    <View
        android:id="@+id/data_opt_in_setting_divider"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_opt_in_switch_title"
        style="@style/BigfootDivider.MarginedDivider"/>
    <View
        android:id="@+id/clickable_row_data_switch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/data_opt_in_setting_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
