<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shoe_controller_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <include
        android:id="@+id/right_shoe_controller_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_shoe_controller_container"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_shoe_controller_container"/>
    <ImageView
        android:id="@+id/slit"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/shadow"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/right_shoe_controller_container"
        app:layout_constraintStart_toStartOf="@+id/right_shoe_controller_container"
        app:layout_constraintTop_toTopOf="@+id/right_shoe_controller_container"/>
    <include
        android:id="@+id/left_shoe_controller_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_shoe_controller_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_shoe_controller_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
