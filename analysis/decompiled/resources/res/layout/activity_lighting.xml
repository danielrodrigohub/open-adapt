<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_lighting_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/transition_to_view"
        android:background="#cc000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="#cc000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/lighting_page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/adapt_lighting_colors_selection_screen_title"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BigfootH1"/>
        <TextView
            android:textColor="#fff"
            android:id="@+id/lighting_screen_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lighting_page_title"
            style="@style/BigfootH4"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/lighting_icons_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/lighting_icons_tab_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lighting_screen_subtitle"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/lighting_icons_tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginBottom="85dp"
            app:layout_constraintBottom_toTopOf="@+id/done_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabRippleColor="@android:color/transparent"/>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/done_parent"
            android:background="@drawable/create_mode_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:minWidth="100dp"
            android:minHeight="40dp"
            android:animateLayoutChanges="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adapt_done_cta_button"
                android:includeFontPadding="false"
                android:fontFamily="@font/helvetica_neue_medium"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/shaded_background"
        android:background="@color/dialog_background_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.nike.adapt.ui.helper.BottomSheet
        android:id="@+id/lighting_bottom_sheet"
        android:background="@drawable/dialog_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:description="@string/adapt_lighting_sheet_firmware_dual_colors"
        app:hasSecondaryButton="false"
        app:icon="@drawable/ic_shoe_adapt"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:primaryButtonText="@string/adapt_home_firmware_upgrade_modal_cta_title"
        app:title="@string/adapt_firmware_update_modal_title"
        style="@style/BottomSheetDialogTheme"/>
    <com.nike.adapt.ui.helper.NotificationToast
        android:id="@+id/lighting_activity_notification_toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:notificationToastDescription="@string/adapt_toast_body_dual_colors_disabled_my_shoes_fw"
        app:notificationToastImage="@drawable/ic_shoe_adapt"
        app:notificationToastTitle="@string/adapt_toast_title_dual_colors_disabled"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
