<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/lights_effects_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="#cc000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/light_effects_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adapt_lighting_effects_selection_screen_title"
            style="@style/BigfootH1"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="52"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/light_effect_sub_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/adapt_choose_effects_subtitle"
            style="@style/BigfootBody"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lights_effects_recycle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="52"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/light_effects_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/adapt_lights_effects_duration_subtitle"
            style="@style/BigfootBody"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/lighting_effect_duration_card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/button_light_background_color"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <View
                android:id="@+id/lighting_effect_duration_indicator"
                android:background="@drawable/lighting_effect_duration_gradient_background"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="50dp"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/lighting_effect_duration_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@null"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@null"/>
        </androidx.cardview.widget.CardView>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="100"/>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/light_effects_done"
            android:background="@drawable/create_mode_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/effect_done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:minHeight="40dp"
                android:text="@string/adapt_done_cta_button"
                android:includeFontPadding="false"
                android:fontFamily="@font/helvetica_neue_medium"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </FrameLayout>
    </LinearLayout>
    <com.nike.adapt.ui.helper.NotificationToast
        android:id="@+id/effects_activity_notification_toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:notificationToastImage="@drawable/ic_shoe_adapt"/>
</FrameLayout>
