<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/single_light_aurora_green"
        app:layout_constraintBottom_toTopOf="@+id/single_light_vivid_purple"
        app:layout_constraintEnd_toStartOf="@+id/single_light_hero_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_hero_blue"
        app:layout_constraintBottom_toTopOf="@+id/single_light_pink_blast"
        app:layout_constraintEnd_toStartOf="@+id/single_light_racer_blue"
        app:layout_constraintStart_toEndOf="@+id/single_light_aurora_green"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_racer_blue"
        app:layout_constraintBottom_toTopOf="@+id/single_light_red_orbit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/single_light_hero_blue"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_vivid_purple"
        app:layout_constraintBottom_toTopOf="@+id/single_light_bright_crimson"
        app:layout_constraintEnd_toStartOf="@+id/single_light_pink_blast"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/single_light_aurora_green"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_pink_blast"
        app:layout_constraintBottom_toTopOf="@+id/single_light_total_orange"
        app:layout_constraintEnd_toStartOf="@+id/single_light_red_orbit"
        app:layout_constraintStart_toEndOf="@+id/single_light_vivid_purple"
        app:layout_constraintTop_toBottomOf="@+id/single_light_hero_blue"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_red_orbit"
        app:layout_constraintBottom_toTopOf="@+id/single_light_optic_yellow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/single_light_pink_blast"
        app:layout_constraintTop_toBottomOf="@+id/single_light_racer_blue"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_bright_crimson"
        app:layout_constraintBottom_toTopOf="@+id/single_light_electric_green"
        app:layout_constraintEnd_toStartOf="@+id/single_light_total_orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/single_light_vivid_purple"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_total_orange"
        app:layout_constraintBottom_toTopOf="@+id/single_light_green_spark"
        app:layout_constraintEnd_toStartOf="@+id/single_light_optic_yellow"
        app:layout_constraintStart_toEndOf="@+id/single_light_bright_crimson"
        app:layout_constraintTop_toBottomOf="@+id/single_light_pink_blast"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_optic_yellow"
        app:layout_constraintBottom_toTopOf="@+id/single_light_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/single_light_total_orange"
        app:layout_constraintTop_toBottomOf="@+id/single_light_red_orbit"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_electric_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/single_light_green_spark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/single_light_bright_crimson"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_green_spark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/single_light_white"
        app:layout_constraintStart_toEndOf="@+id/single_light_electric_green"
        app:layout_constraintTop_toBottomOf="@+id/single_light_total_orange"
        style="@style/LedLightIcon"/>
    <ImageView
        android:id="@+id/single_light_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/single_light_green_spark"
        app:layout_constraintTop_toBottomOf="@+id/single_light_optic_yellow"
        style="@style/LedLightIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
