<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_put_on_shoes_onboarding_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/put_on_shoes_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/put_on_shoes_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/put_on_shoes_find_perfect_fit"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BigfootH1"/>
        <TextView
            android:id="@+id/put_on_shoes_description_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lines="3"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/put_on_shoes_title"
            style="@style/BigfootBody"/>
        <ImageView
            android:id="@+id/put_on_shoes_image_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/put_on_your_shoes_tertiary_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/put_on_shoes_description_one"/>
        <Button
            android:textSize="12sp"
            android:textColor="#ff111111"
            android:id="@+id/put_on_your_shoes_tertiary_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/do_you_wear_orthotics"
            android:textAllCaps="false"
            android:fontFamily="Helvetica Neue"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toTopOf="@+id/put_on_shoes_begin_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/put_on_shoes_begin_button"
            android:background="@drawable/background_dark_pill_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minHeight="60dp"
            android:text="@string/adapt_modes_calibration_button"
            android:textAllCaps="false"
            android:fontFamily="Helvetica Neue"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toTopOf="@+id/put_on_shoes_secondary_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:id="@+id/put_on_shoes_secondary_button"
            android:background="@drawable/text_selector_pill_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minHeight="60dp"
            android:text="@string/adapt_skip_button_title"
            android:textAllCaps="false"
            android:fontFamily="Helvetica Neue"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toTopOf="@+id/space_when_no_secondary_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="?android:attr/borderlessButtonStyle"/>
        <Space
            android:id="@+id/space_when_no_secondary_button"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
