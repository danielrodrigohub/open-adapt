<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/settings_profile_stats"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="47dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/setting_profile_avatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/bigfoot_ic_default_avatar"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <TextView
            android:textColor="@color/battery_background_ani"
            android:id="@+id/settings_profile_stats_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@+id/setting_profile_avatar"
            style="@style/BigfootH3"/>
        <TextView
            android:textColor="#8d8d8d"
            android:id="@+id/settings_profile_stats_member_since"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/settings_profile_stats_name"
            android:layout_alignStart="@+id/settings_profile_stats_name"
            style="@style/BigfootButtonLabel"/>
        <TextView
            android:textColor="#8d8d8d"
            android:id="@+id/settings_profile_stats_age_plus_city"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/settings_profile_stats_member_since"
            android:layout_alignStart="@+id/settings_profile_stats_name"
            style="@style/BigfootButtonLabel"/>
    </RelativeLayout>
</LinearLayout>
