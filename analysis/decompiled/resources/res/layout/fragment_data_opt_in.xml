<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fragment_data_opt_in_container"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textAppearance="@style/BigfootButtonTextAppearance"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/data_opt_in_allow"
        android:background="@drawable/background_dark_pill_button"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/adapt_share_data_cta"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@+id/data_opt_in_dont_allow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="0dp"
        style="?android:attr/borderlessButtonStyle"/>
    <ProgressBar
        android:id="@+id/data_opt_in_allow_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:translationZ="50dp"
        android:indeterminateTint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/data_opt_in_allow"
        app:layout_constraintEnd_toEndOf="@+id/data_opt_in_allow"
        app:layout_constraintStart_toStartOf="@+id/data_opt_in_allow"
        app:layout_constraintTop_toTopOf="@+id/data_opt_in_allow"/>
    <Button
        android:textAppearance="@style/BigfootButtonTextAppearance"
        android:textStyle="bold"
        android:id="@+id/data_opt_in_dont_allow"
        android:background="@drawable/text_selector_pill_button"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adapt_data_opt_dont_allow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:id="@+id/data_opt_in_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/adapt_help_us_improve_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BigfootH1"/>
    <TextView
        android:id="@+id/data_opt_in_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/adapt_data_opt_in_sub_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_opt_in_title"
        style="@style/BigfootBody"/>
    <TextView
        android:textColor="@color/percent_light_grey"
        android:gravity="center"
        android:id="@+id/learn_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/adapt_data_opt_settings_subcopy"
        app:layout_constraintBottom_toTopOf="@+id/data_opt_in_allow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BigfootList"/>
</androidx.constraintlayout.widget.ConstraintLayout>
