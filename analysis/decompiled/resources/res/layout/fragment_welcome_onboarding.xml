<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/welcome_screen"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:id="@+id/logout_button"
            android:text="@string/adapt_logout_title"
            style="@style/ExitOnboardingButton"/>
        <TextView
            android:id="@+id/welcome_headline"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BigfootH1"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"/>
        <TextView
            android:id="@+id/welcome_power_on"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adapt_onboarding_pairing_hello_subtitle"
            style="@style/BigfootH4"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="220"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/adapt_welcome"
            android:scaleType="fitCenter"
            android:layout_weight="300"
            android:scaleX="0.95"
            android:scaleY="0.95"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="153"/>
        <TextView
            android:textColor="@color/learn_more_copy"
            android:id="@+id/item_adapt_learn_more_copy"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adapt_pairing_requires_data_label"
            android:textAlignment="center"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/item_adapt_learn_more_url"
            android:paddingBottom="24dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adapt_learn_more_title"
            android:textAlignment="center"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"/>
        <include layout="@layout/item_messaging_cta"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/fetching_profile_progress_bar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:translationY="-20dp"
        android:indeterminateTint="@android:color/black"/>
</FrameLayout>
