<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/auto_lace_activity_parent"
        android:background="@color/background_color_light_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/view_toolbar"
            layout="@layout/view_toolbar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/auto_lace_enable_parent"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_toolbar">
            <Button
                android:textSize="20sp"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/auto_lace_activity_enable_text"
                android:background="@null"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auto_lace_feature_enable"
                android:lineSpacingExtra="0.25sp"
                android:textAllCaps="false"
                android:fontFamily="@font/helvetica_neue_medium"
                android:layout_marginStart="24dp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?android:attr/borderlessButtonStyle"/>
            <Switch
                android:theme="@style/ThemeOverlay.BlueSwitch"
                android:gravity="center_vertical"
                android:id="@+id/auto_lace_activity_enable_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/adapt_shoe_preferences_auto_lace_title"
                android:paddingEnd="8dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/auto_lace_activity_enable_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/auto_lace_activity_enable_text"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_black"
                android:id="@+id/auto_lace_activity_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/auto_lace_feature_description"
                android:fontFamily="@font/helvetica_neue_regular"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/auto_lace_activity_enable_text"/>
            <View
                android:id="@+id/auto_lace_disabled_divider"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/BigfootDivider.MarginedDivider"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color_light_gray"
            android:id="@+id/auto_lace_activity_options_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/auto_lace_option_list_header"
            android:fontFamily="@font/helvetica_neue_regular"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@+id/auto_lace_enable_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/auto_lace_options_list"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auto_lace_activity_options_header"/>
        <com.nike.adapt.ui.helper.NotificationToast
            android:id="@+id/auto_lace_fit_saved_notification_toast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:translationZ="2dp"
            android:elevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:notificationToastDescription="@string/auto_lace_saved_default_notification_toast_description"
            app:notificationToastImage="@drawable/ic_shoe_adapt"
            app:notificationToastTitle="@string/auto_lace_saved_default_notification_toast_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/shaded_background"
        android:background="@color/dialog_background_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.nike.adapt.ui.helper.BottomSheet
        android:id="@+id/auto_lace_bottom_sheet"
        android:background="@drawable/dialog_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:description="@string/auto_lace_action_sheet_body"
        app:hasSecondaryButton="false"
        app:icon="@drawable/ic_shoe_adapt"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:primaryButtonText="@string/adapt_ok_cta_button"
        app:title="@string/auto_lace_action_sheet_title"
        style="@style/BottomSheetDialogTheme"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
