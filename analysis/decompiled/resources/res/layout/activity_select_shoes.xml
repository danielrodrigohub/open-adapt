<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_select_shoes_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textAppearance="@style/BigfootButtonTextAppearance"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/messaging_cta_primary"
        android:background="@drawable/background_dark_pill_button"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/adapt_myshoes_connect_cta"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@+id/messaging_cta_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="0dp"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:textAppearance="@style/BigfootButtonText"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/messaging_cta_secondary"
        android:background="@drawable/text_selector"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/adapt_myshoes_remove_shoes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="0dp"
        style="?android:attr/borderlessButtonStyle"/>
    <ImageView
        android:id="@+id/activity_select_shoes_icon"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:src="@drawable/colorway_default_bb_profile"
        android:layout_centerHorizontal="true"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_toolbar"
        app:layout_constraintVertical_bias="0.35"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_shoe_lottie"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_enableMergePathsForKitKatAndAbove="true"
        app:lottie_fileName="lottie_spinner.json"
        app:lottie_imageAssetsFolder="assets/"/>
    <include
        android:id="@+id/view_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
