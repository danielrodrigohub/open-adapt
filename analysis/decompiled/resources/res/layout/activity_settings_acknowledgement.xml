<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/view_toolbar"
        layout="@layout/view_toolbar"/>
    <TextView
        android:gravity="center"
        android:id="@+id/settings_acknowledgement_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adapt_settings_acknowledgement_copy"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        style="@style/BigfootSettingsText"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/android_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_android_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/android_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_android"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/retrofit_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_retrofit_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/retrofit_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_retrofit"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/gson_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_gson_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/gson_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_gson"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/okhttp_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_okhttp_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/okhttp_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_okhttp"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/newrelic_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_newrelic_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/newrelic_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_newrelic"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/segment_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_segment_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/segment_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_segment"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/lottie_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_lottie_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/lottie_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_lottie"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/glide_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_glide_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/glide_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_glide"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/eventbus_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_event_bus_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/eventbus_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_event_bus"
                style="@style/BigfootAcknowledgmentText"/>
            <TextView
                android:id="@+id/roboelectric_license_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_roboelectric_title"
                style="@style/BigfootAcknowledgmentTitle"/>
            <TextView
                android:id="@+id/roboelectric_license_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/license_roboelectric"
                style="@style/BigfootAcknowledgmentText"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
