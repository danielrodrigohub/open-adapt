<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:textAppearance="@style/BigfootButtonTextAppearance"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/messaging_cta_primary"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:textAllCaps="false"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lineHeight="0dp"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:textAppearance="@style/BigfootButtonTextAppearance"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/messaging_cta_secondary"
        android:background="@drawable/text_selector"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/messaging_cta_primary"
        app:layout_constraintStart_toStartOf="@+id/messaging_cta_primary"
        app:layout_constraintTop_toBottomOf="@+id/messaging_cta_primary"
        app:lineHeight="0dp"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
