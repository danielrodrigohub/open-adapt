<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/choose_your_shoes_title"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/choose_your_shoes"
        android:layout_marginStart="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BigfootH1"/>
    <TextView
        android:id="@+id/choose_your_shoes_description_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unable_recognize_shoes"
        android:layout_marginStart="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/choose_your_shoes_title"
        style="@style/BigfootBody"/>
    <TextView
        android:id="@+id/choose_your_shoes_description_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_your_pair_below"
        android:layout_marginStart="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/choose_your_shoes_description_one"
        style="@style/BigfootBody"/>
</androidx.constraintlayout.widget.ConstraintLayout>
