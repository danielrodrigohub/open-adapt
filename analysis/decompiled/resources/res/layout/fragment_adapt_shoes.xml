<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/adapt_shoe_controller_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/shoe_controller_frame"
        android:paddingTop="140dp"
        android:paddingBottom="100dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/shoe_controller_combined"
            layout="@layout/item_shoe_controller_container_combined"/>
        <include
            android:id="@+id/shoe_scale_controller"
            layout="@layout/item_shoe_scale_container_combined"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/shoe_controller_messaging_container"
        android:padding="16dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/item_messaging_headline"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <include layout="@layout/item_messaging_cta"/>
    </LinearLayout>
    <include
        android:id="@+id/item_preset_creation"
        android:visibility="gone"
        layout="@layout/item_preset_creation"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/preset_creation_checkmark_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preset_creation_checkmark"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/preset_creation_status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:lottie_enableMergePathsForKitKatAndAbove="true"
            app:lottie_fileName="checkmark.json"
            app:lottie_imageAssetsFolder="assets/"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:id="@+id/preset_creation_checkmark_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/adapt_nrc_pairing_completion_confirmation"
            android:fontFamily="@font/helvetica_neue_regular"
            style="@style/BigfootH1"/>
    </LinearLayout>
</FrameLayout>
