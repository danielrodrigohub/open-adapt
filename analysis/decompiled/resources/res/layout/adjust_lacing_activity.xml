<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adjust_lacing_activity_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/white"
        android:id="@+id/adjust_lacing_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/auto_lace_adjust_fit_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BigfootH1"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/adjust_lacing_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/adapt_fine_tune_both_shoes_body"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adjust_lacing_title"
        style="@style/BigfootBody"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/adjust_lacing_cta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adjust_lacing_subtitle">
        <include
            android:id="@+id/adjust_lacing_container"
            layout="@layout/item_shoe_controller_container_combined"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:enabled="false"
        android:textAppearance="@style/BigfootButtonTextAppearance"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/adjust_lacing_cta"
        android:background="@drawable/background_white_pill_button"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/auto_lace_adjust_fit_cta"
        android:alpha="0.5"
        android:textAllCaps="false"
        android:fontFamily="@font/helvetica_neue_medium"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="0dp"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
