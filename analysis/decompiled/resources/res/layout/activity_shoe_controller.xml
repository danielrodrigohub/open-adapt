<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.exoplayer2.ui.PlayerView
            android:gravity="center"
            android:id="@+id/background_video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:forceHasOverlappingRendering="true"
            app:resize_mode="fill"
            app:use_controller="false">
            <ImageView
                android:id="@+id/static_gradient_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.google.android.exoplayer2.ui.PlayerView>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/center"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/nike_swoosh"
            android:paddingTop="80dp"
            android:paddingBottom="140dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/shoe_controller"
                layout="@layout/item_shoe_controller_container_combined"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/shoe_controller_swoosh"
            android:visibility="gone"
            android:layout_width="85dp"
            android:layout_height="30dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_swoosh"
            app:tint="@android:color/white"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/shoe_controller_jumpman"
            android:visibility="gone"
            android:layout_width="57dp"
            android:layout_height="53dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_jordan_jumpman_logo"
            app:tint="@android:color/white"/>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/text_view_dmc_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="120dp"
            layout="@layout/text_view_dmc"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/icons_container"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="128dp">
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <FrameLayout style="@style/ShoeControllerIconContainer">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/presets_saved_animation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:lottie_enableMergePathsForKitKatAndAbove="true"
                    app:lottie_fileName="save_mode.json"
                    app:lottie_imageAssetsFolder="assets/"/>
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/shoe_controller_icon_mode"
                    android:background="@drawable/ic_lacing_icon_background"
                    android:padding="8dp"
                    android:foreground="@android:color/transparent"
                    style="@style/ShoeControllerIcon">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_modes"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/adapt_modes_title"
                        app:tint="@android:color/white"/>
                </FrameLayout>
            </FrameLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <FrameLayout style="@style/ShoeControllerIconContainer">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/lighting_halo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:lottie_enableMergePathsForKitKatAndAbove="true"
                    app:lottie_fileName="save_mode.json"
                    app:lottie_imageAssetsFolder="assets/"/>
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/home_light_parent"
                    android:background="@drawable/ic_lacing_icon_background"
                    android:contentDescription="@string/adapt_accessibility_lighting_button"
                    style="@style/ShoeControllerIcon">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/lights_off_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_lights_off_home"
                        android:scaleType="fitCenter"/>
                    <FrameLayout
                        android:id="@+id/color_without_effects_container"
                        android:padding="8dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_dynamic_lighting_icon_outer_ring"
                            android:scaleType="fitCenter"/>
                        <com.nike.adapt.ui.view.DuoColorView
                            android:layout_gravity="center"
                            android:id="@+id/no_effects_light_color"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:duoColorType="DUO_COLOR_TYPE_HOME"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/color_with_effects_container"
                        android:padding="8dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_effects_light_white_dashes"
                            android:scaleType="fitCenter"/>
                        <com.nike.adapt.ui.view.DuoColorView
                            android:layout_gravity="center"
                            android:id="@+id/effects_light_color"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            app:duoColorType="DUO_COLOR_TYPE_HOME_WITH_EFFECTS"/>
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/icon_battery_lacing_screen_container"
                android:background="@drawable/ic_lacing_icon_background"
                android:padding="8dp"
                android:layout_margin="6dp"
                style="@style/ShoeControllerIcon">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_battery_lacing_screen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_battery_0_percent"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/adapt_battery_view_title"/>
            </FrameLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/unlace_or_lace_up"
                android:background="@drawable/ic_lacing_icon_background"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:contentDescription="@string/adapt_accessibility_release_button"
                style="@style/ShoeControllerIcon">
                <ImageView
                    android:id="@+id/unlace_or_lace_up_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_lacing_0"
                    android:scaleType="centerInside"
                    app:tint="@android:color/white"/>
            </FrameLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/bigfoot_lacing_settings"
            android:background="@drawable/round_background"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:contentDescription="@string/adapt_settings_title"
            android:layout_marginEnd="30dp">
            <ImageView
                android:id="@+id/bigfoot_lacing_settings_icon"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/shoe_controller_settings_badge"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                android:layout_marginStart="33dp"
                android:layout_marginEnd="8dp"
                style="@style/BadgeText"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="start"
            android:id="@+id/bigfoot_lacing_shoe_preferences"
            android:background="@drawable/round_background"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="54dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="30dp">
            <ImageView
                android:id="@+id/bigfoot_lacing_shoe_preferences_icon"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_shoe"
                android:scaleType="centerInside"
                android:contentDescription="@string/adapt_myshoes_index_headline"/>
            <TextView
                android:id="@+id/shoe_controller_my_shoe_badge"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                android:layout_marginStart="33dp"
                android:layout_marginEnd="8dp"
                style="@style/BadgeText"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:id="@+id/shaded_background"
        android:background="@color/dialog_background_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.nike.adapt.ui.helper.BottomSheet
        android:id="@+id/google_voice_bottom_sheet"
        android:background="@drawable/dialog_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:fadedOutContent="true"
        app:hasTitle="false"
        app:icon="@drawable/hey_google"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:primaryButtonText="@string/google_voice_lacing_notification_try_now"
        app:secondaryButtonText="@string/google_voice_lacing_notification_dismiss"
        style="@style/BottomSheetDialogTheme"/>
    <com.nike.adapt.ui.helper.BottomSheet
        android:id="@+id/jordan_app_icon_bottom_sheet"
        android:background="@drawable/dialog_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:description="@string/adapt_app_icon_action_sheet_copy"
        app:icon="@drawable/ic_adapt_jordan_outline"
        app:isDraggingDisabled="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:primaryButtonText="@string/adapt_app_icon_CTA"
        app:secondaryButtonText="@string/adapt_app_icon_action_sheet_dismiss"
        app:title="@string/adapt_app_icon_action_sheet_jordan_title"
        style="@style/BottomSheetDialogTheme"/>
    <com.nike.adapt.ui.helper.NotificationToast
        android:id="@+id/auto_lace_unlaced_notification_toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:notificationToastDescription="@string/auto_lace_unlace_notification_toast_description"
        app:notificationToastImage="@drawable/ic_shoe_adapt"
        app:notificationToastTitle="@string/auto_lace_unlace_notification_toast_title"/>
    <com.nike.adapt.ui.helper.NotificationToast
        android:id="@+id/activity_shoe_controller_notification_toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.nike.adapt.ui.helper.NotificationToast
        android:id="@+id/decommission_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:notificationToastIsDismissible="false"
        app:notificationToastUseDefaultBehavior="false"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
