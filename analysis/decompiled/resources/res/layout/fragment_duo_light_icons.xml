<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_racer_blue_opti_yellow"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_vivid_purple_opti_yellow"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_racer_blue_electric_green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_racer_blue_electric_green"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_vivid_purple_white"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_racer_blue_aurora_green"
        app:layout_constraintStart_toEndOf="@+id/duo_light_racer_blue_opti_yellow"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_racer_blue_aurora_green"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_vivid_purple_aurora_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/duo_light_racer_blue_electric_green"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_vivid_purple_opti_yellow"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_red_orbit_racer_blue"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_vivid_purple_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_racer_blue_opti_yellow"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_vivid_purple_white"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_red_orbit_opti_yellow"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_vivid_purple_aurora_green"
        app:layout_constraintStart_toEndOf="@+id/duo_light_vivid_purple_opti_yellow"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_racer_blue_electric_green"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_vivid_purple_aurora_green"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_red_orbit_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/duo_light_vivid_purple_white"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_racer_blue_aurora_green"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_red_orbit_racer_blue"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_green_spark_opti_yellow"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_red_orbit_opti_yellow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_vivid_purple_opti_yellow"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_red_orbit_opti_yellow"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_green_spark_white"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_red_orbit_white"
        app:layout_constraintStart_toEndOf="@+id/duo_light_red_orbit_racer_blue"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_vivid_purple_white"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_red_orbit_white"
        app:layout_constraintBottom_toTopOf="@+id/duo_light_hero_blue_pink_blast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/duo_light_red_orbit_opti_yellow"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_vivid_purple_aurora_green"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_green_spark_opti_yellow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_green_spark_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_red_orbit_racer_blue"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_green_spark_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/duo_light_hero_blue_pink_blast"
        app:layout_constraintStart_toEndOf="@+id/duo_light_green_spark_opti_yellow"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_red_orbit_opti_yellow"
        style="@style/DuoLightIcon"/>
    <com.nike.adapt.ui.view.DuoImageView
        android:id="@+id/duo_light_hero_blue_pink_blast"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/duo_light_green_spark_white"
        app:layout_constraintTop_toBottomOf="@+id/duo_light_red_orbit_white"
        style="@style/DuoLightIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
