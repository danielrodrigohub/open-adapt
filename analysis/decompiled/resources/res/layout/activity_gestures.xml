<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/view_toolbar"
        layout="@layout/view_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_gestures_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/activity_gestures_feedback_description"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/BigfootH3"
                    android:textColor="@color/edit_field_dark_black"
                    android:id="@+id/activity_gestures_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="@string/adapt_shoe_preferences_gestures_my_gestures_title"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Button
                    android:textAppearance="@style/BigfootH4"
                    android:gravity="center_vertical"
                    android:id="@+id/activity_gestures_heel_tap_switch_label"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/adapt_shoe_preference_gestures_my_gestures_heel_tap_to_unlace_copy"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintEnd_toStartOf="@+id/activity_gestures_heel_tap_switch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_title"
                    style="?android:attr/borderlessButtonStyle"/>
                <Switch
                    android:theme="@style/ThemeOverlay.BlueSwitch"
                    android:gravity="center_vertical"
                    android:id="@+id/activity_gestures_heel_tap_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/activity_gestures_heel_tap_switch_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/activity_gestures_heel_tap_switch_label"/>
                <View
                    android:id="@+id/activity_gestures_heel_tap_divider"
                    android:layout_marginTop="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_heel_tap_switch_label"
                    style="@style/BigfootDivider.MarginedDivider"/>
                <TextView
                    android:textAppearance="@style/BigfootH5"
                    android:id="@+id/activity_gestures_heel_tap_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/adapt_shoe_preference_gestures_my_gestures_section_description"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_heel_tap_divider"/>
                <TextView
                    android:textAppearance="@style/BigfootH3"
                    android:id="@+id/activity_gestures_tutorials_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/adapt_shoe_preferences_gestures_tutorials_title"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_heel_tap_description"/>
                <Button
                    android:textAppearance="@style/BigfootH4"
                    android:textColor="#2ea4ff"
                    android:gravity="center_vertical"
                    android:id="@+id/activity_gestures_heel_tap_tutorial_button"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/adapt_shoe_preferences_gestures_tutorials_heel_tap_to_unlace_copy"
                    android:paddingStart="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_tutorials_title"
                    style="?android:attr/borderlessButtonStyle"/>
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_row_right_arrow"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/activity_gestures_heel_tap_tutorial_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/activity_gestures_heel_tap_tutorial_button"/>
                <View
                    android:id="@+id/activity_gestures_heel_tap_tutorial_divider"
                    android:layout_marginTop="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_heel_tap_tutorial_button"
                    style="@style/BigfootDivider.MarginedDivider"/>
                <TextView
                    android:textAppearance="@style/BigfootH5"
                    android:id="@+id/activity_gestures_heel_tap_tutorial_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/adapt_shoe_preferences_gestures_tutorials_section_description"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/activity_gestures_heel_tap_tutorial_divider"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <TextView
            android:textAppearance="@style/BigfootH5"
            android:id="@+id/activity_gestures_feedback_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/adapt_gestures_submit_feedback_footer_description"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/activity_gestures_feedback_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/activity_gestures_feedback_button"
            android:padding="16dp"
            android:clickable="true"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/GrayBorderRoundButton">
            <TextView
                android:textAppearance="@style/BigfootH4"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adapt_submit_feedback_title"
                android:drawablePadding="4dp"
                android:textAllCaps="false"
                android:drawableStart="@drawable/ic_submit_feedback"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
